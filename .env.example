# PostgreSQL connection string
# Local (Docker): postgresql://postgres:secret@localhost:5432/notes
# Render: automatically injected via DATABASE_URL env var from linked DB
DATABASE_URL=postgresql://postgres:secret@localhost:5432/notes

# Auth0 tenant domain — include the trailing slash
# Found in Auth0 Dashboard → Settings → Domain
AUTH0_DOMAIN=https://your-tenant.us.auth0.com/

# Public base URL of this server (no trailing slash)
# Local: your ngrok URL  e.g. https://abc123.ngrok-free.app
# Production: your Render URL e.g. https://your-app.onrender.com
SERVER_BASE_URL=https://your-server-url.com

# AUTH0_AUDIENCE is not required — Auth0MCPProvider auto-binds the audience
# to SERVER_BASE_URL/mcp at startup. Just make sure your Auth0 API identifier
# matches exactly what gets logged at startup.
